#!/bin/sh
set -e

# The game server. Its configuration is the environment: MYSQL_HOST,
# MYSQL_USERNAME, MYSQL_PASSWORD, MYSQL_DATABASE, JWT_PRIVATE_KEY and
# JWT_PUBLIC_KEY (base64 PEM), and SMTP_HOST, SMTP_PORT, SMTP_FROM,
# SMTP_USERNAME, SMTP_PASSWORD. nginx reaches it on the socket below.
mkdir -p /run/darksignsonline
chown nginx:nginx /run/darksignsonline

exec s6-setuidgid nginx env DSO_LISTEN=unix:/run/darksignsonline/server.sock /usr/bin/darksignsonline-server
