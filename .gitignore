.DS_Store
/client/dso.ini
/client/user/system/mail.dat
# The player's own files, save for the readme.txt that brings each directory
# into being. Ignoring a directory outright is the end of it -- git does not
# look inside one it has excluded, so no later `!` line can bring a file back
# out -- hence the contents are ignored instead, and `music/` is re-included
# before the file inside it can be.
/client/user/downloads/*
!/client/user/downloads/readme.txt
/client/user/home/*
!/client/user/home/music/
/client/user/home/music/*
!/client/user/home/music/readme.txt
/client/user/system/libs/hash_*.ds
/client/user/system/missions/*.ini
/server/LICENSE
/client/user/darksigns/DS_scr
/client/user/darksigns/DS_scr_todo
/client/user/darksigns/DS_srv
/result
/client/web/node_modules
/client/web/dist

# Local WebKit/playwright rig, machine-specific (see CLAUDE.md).
/.claude/webkit.md
/.claude/webkit-env.sh
